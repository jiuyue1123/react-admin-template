VITE_APP_TITLE=后台管理系统

VITE_APP_DESC=后台管理系统

# 后端服务成功码：当收到该 code 时，请求视为成功
VITE_SERVICE_SUCCESS_CODE=0000

# 后端服务登出码：当收到该 code 时，用户将被登出并跳转到登录页
VITE_SERVICE_LOGOUT_CODES=20105,20104

# 后端服务弹窗登出码：当收到该 code 时，将以弹窗形式登出用户
VITE_SERVICE_MODAL_LOGOUT_CODES=40005

# 后端服务令牌过期码：当收到该 code 时，将刷新令牌并重新发送请求
VITE_SERVICE_EXPIRED_TOKEN_CODES=40001,40002,40003

# 当路由模式为静态时，定义的超级角色
VITE_SUPER_ROLE=super_admin
