# 后端服务地址（仅服务端可见，浏览器不可见）
# 访客端所有取数都走这个后端的 /public/site/* 公开接口
SITE_API_ORIGIN=http://localhost:8080

# 后端成功码（与 admin 的 VITE_SERVICE_SUCCESS_CODE 同源）
SITE_API_SUCCESS_CODE=0000

# 站点基础域名：用于把 acme.jianfanfang.com 还原成站点标签 acme
SITE_BASE_DOMAIN=jianfanfang.com

# 站点对外协议（用于生成 canonical 等绝对 URL）
SITE_PUBLIC_PROTO=https

# 本地开发用：浏览器访问 localhost 时冒充的站点 Host
# 本地没有子域名，此项让 http://localhost:3001 直接渲染某个真实站点
# 留空则 localhost 视为无租户语义，落到「站点不存在」
DEV_SITE_HOST=
